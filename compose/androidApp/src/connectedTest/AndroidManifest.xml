<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Baseline-profile generation (task #25): androidx.benchmark.macro.junit4.BaselineProfileRule
      wraps the generator in GrantPermissionRule.grant(WRITE_EXTERNAL_STORAGE). The grant fails
      ("Failed to grant permissions") unless the permission is declared, so declare the legacy
      storage permissions for the connectedTest carrier only. On API 30+ the actual profile output
      uses the app's scoped external-files dir; these declarations only satisfy the rule's grant.
      Never added to production variants.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application>
        <!--
          No emoji2 EmojiCompatInitializer in the connectedTest carrier. Its default config loads
          the emoji font through Play services' FontsProvider (com.google.android.gms.fonts), and a
          process holding that provider dies with it: on CI emulators Play services restarts its
          persistent process shortly after boot ("ChimeraModuleLdr: Module config changed, forcing
          restart"), and ActivityManager then kills the app ("depends on provider
          com.google.android.gms/.fonts.provider.FontsProvider in dying proc", exit reason
          DEPENDENCY DIED). Visual run 44924992344 lost a capture case that way, with no crash in
          the log. Release, play, alpha and debug keep the initializer.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
        <activity
            android:name="build.raft.app.shared.AndroidImeVisibilityProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>

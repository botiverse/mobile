<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Raft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/raft_window_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/raft_accent_pink</item>
        <item name="android:textColorHighlight">@color/raft_accent_pink</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Dark bar icons from the first frame. Compose Dialog windows (menus, sheets,
             popovers) inherit this theme; without it they were added with light icons
             and RaftModalDialogWindowEffect only fixed them a frame later, so the status
             bar icons blinked white-on-white whenever a menu opened. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Raft.Starting" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/raft_window_background</item>
        <item name="windowSplashScreenBackground">@color/raft_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Raft</item>
    </style>

    <style name="Theme.Raft.AppShellStarting" parent="Theme.Raft.Starting" />

    <!-- Pushed Kuikly pages (thread, members, ...) run inside
         RaftLegacyHostActivity stacked on top of another app activity.
         A translucent window lets the underlying page show through the
         open/close transition instead of flashing the opaque cream
         window background while the Kuikly render surface attaches.
         The app-shell activities keep their opaque splash themes. -->
    <style name="Theme.Raft.Translucent" parent="Theme.Raft">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>

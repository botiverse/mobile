<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Raft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/raft_window_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/raft_accent_pink</item>
        <item name="android:textColorHighlight">@color/raft_accent_pink</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Dark bar icons from the first frame. Compose Dialog windows (menus, sheets,
             popovers, all opened through designsystem RaftWindowDialog) inherit this theme;
             without it they were added with light icons and RaftDialogWindowPolicy only set
             them a frame later, so the status bar icons blinked white-on-white whenever a
             menu opened in the light theme. RaftDialogWindowPolicy then sets them from
             RaftTheme.isDark (light icons in the dark theme). -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Raft.Starting" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/raft_window_background</item>
        <item name="windowSplashScreenBackground">@color/raft_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Raft</item>
    </style>

    <style name="Theme.Raft.AppShellStarting" parent="Theme.Raft.Starting" />

    <!-- Pushed Kuikly pages (thread, members, ...) run inside
         RaftLegacyHostActivity stacked on top of another app activity.
         A translucent window lets the underlying page show through the
         open/close transition instead of flashing the opaque cream
         window background while the Kuikly render surface attaches.
         The app-shell activities keep their opaque splash themes.
         A translucent window alone would also change the open transition: Android swaps the
         platform's activity_open_enter / activity_close_exit for the translucent pair, which
         rises from the bottom and sinks back down (a DM opened from Home slid up like a sheet,
         Android 1.16.1). Animation.Raft.PagePush names app-owned animations, so pushed pages
         enter from the right and leave to the right, as on iOS. -->
    <style name="Theme.Raft.Translucent" parent="Theme.Raft">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.Raft.PagePush</item>
    </style>

    <!-- Push/pop for pages stacked in RaftCmpActivity (channel, DM, thread, settings detail,
         ...). Only the activity open/close attributes are set; dialog windows keep the window
         enter/exit animations the parent gives them (RaftPagePushTransitionTest). -->
    <style name="Animation.Raft.PagePush" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/raft_page_push_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/raft_page_push_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/raft_page_push_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/raft_page_pop_exit</item>
    </style>

    <!-- raft-ui Motion: slides take 220ms to 380ms (RaftMotion). -->
    <integer name="raft_page_push_millis">300</integer>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slock_agent_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/slock_widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/slock_widget_header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/slock_agent_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk_bold"
            android:maxLines="1"
            android:text="Live Agents"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/slock_agent_widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/slock_widget_stat_background"
            android:fontFamily="@font/space_grotesk_bold"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Refresh"
            android:textColor="@color/black"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/slock_agent_widget_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/slock_widget_pink_stat_background"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/slock_agent_widget_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:maxLines="1"
                    android:text="No active agent"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/slock_agent_widget_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/slock_widget_status_dot_offline"
                        android:text="" />

                    <TextView
                        android:id="@+id/slock_agent_widget_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk_medium"
                        android:maxLines="1"
                        android:text="Offline"
                        android:textColor="#99000000"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/slock_agent_widget_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk_regular"
            android:maxLines="1"
            android:text="Open Raft to start"
            android:textColor="#99000000"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

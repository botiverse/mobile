<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No-Play-services background connection (RaftBackgroundConnectionService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Download centre: keeps a user-started attachment download alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application android:name=".RaftApplication" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.Raft">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/raft_file_paths" />
        </provider>

        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <service
            android:name=".push.RaftFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".shared.RaftBackgroundConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <service
            android:name=".shared.RaftDownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Page host: every page renders on Compose Multiplatform (RaftCmpRouter /
             RaftPageRegistry). adjustResize so Compose receives IME insets on every API level.
             Hosts handle rotation, resizes and the OS light/dark switch (uiMode) in place:
             Compose follows the new Configuration, and recreating the host would reset the
             bottom tab and drop the open page (RaftHostConfigChangesTest). -->
        <activity
            android:name=".shared.RaftCmpActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Raft.Translucent"
            android:windowSoftInputMode="adjustResize" />
        <!-- Pre-rename component name (Slock -> Raft), kept for Intents persisted by
             older versions: notifications, shortcuts, recents, external tools. -->
        <activity-alias
            android:name=".shared.SlockCmpActivity"
            android:exported="false"
            android:targetActivity=".shared.RaftCmpActivity" />
        <!-- Former Kuikly host, kept as an entry point (diagnostics alias, Intents from older
             versions); a RaftCmpActivity subclass with the same behaviour. -->
        <activity
            android:name=".shared.RaftLegacyHostActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Raft.Translucent"
            android:windowSoftInputMode="adjustResize" />
        <!-- Pre-rename component name (Slock -> Raft), kept for Intents persisted by
             older versions: notifications, shortcuts, recents, external tools. -->
        <activity-alias
            android:name=".shared.SlockKuiklyActivity"
            android:exported="false"
            android:targetActivity=".shared.RaftLegacyHostActivity" />
        <activity
            android:name=".shared.RaftAppShellActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Raft.AppShellStarting"
            android:windowSoftInputMode="adjustResize" />
        <!-- Pre-rename component name (Slock -> Raft), kept for Intents persisted by
             older versions: notifications, shortcuts, recents, external tools. -->
        <activity-alias
            android:name=".shared.SlockAppShellActivity"
            android:exported="false"
            android:targetActivity=".shared.RaftAppShellActivity" />
        <activity
            android:name=".shared.RaftDocumentShellActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.Raft.AppShellStarting"
            android:windowSoftInputMode="adjustResize" />
        <!-- Pre-rename component name (Slock -> Raft), kept for Intents persisted by
             older versions: notifications, shortcuts, recents, external tools. -->
        <activity-alias
            android:name=".shared.SlockDocumentShellActivity"
            android:exported="false"
            android:targetActivity=".shared.RaftDocumentShellActivity" />
        <activity-alias
            android:name=".core.diagnostics.DiagnosticsDeepLinkActivity"
            android:enabled="@bool/diagnostics_deeplink_enabled"
            android:exported="@bool/diagnostics_deeplink_enabled"
            android:targetActivity=".shared.RaftLegacyHostActivity">
            <intent-filter>
                <action android:name="build.raft.app.diagnostics.OPEN" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".widget.RaftWidgetServerConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Raft" />
        <!-- Pre-rename component name (Slock -> Raft), kept for Intents persisted by
             older versions: notifications, shortcuts, recents, external tools. -->
        <activity-alias
            android:name=".widget.SlockWidgetServerConfigureActivity"
            android:exported="true"
            android:targetActivity=".widget.RaftWidgetServerConfigureActivity" />
        <activity
            android:name=".core.data.auth.QaSessionBootstrapActivity"
            android:enabled="@bool/qa_session_bootstrap_enabled"
            android:excludeFromRecents="true"
            android:exported="@bool/qa_session_bootstrap_enabled"
            android:theme="@style/Theme.Raft.Starting" />
        <receiver
            android:name=".core.data.auth.QaCaptureBoundaryReceiver"
            android:enabled="@bool/qa_session_bootstrap_enabled"
            android:exported="@bool/qa_session_bootstrap_enabled">
            <intent-filter>
                <action android:name="build.raft.app.qa.CAPTURE_BOUNDARY" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Raft.Starting"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <!--
                Raft message links (#proj-mobile #25): verified App Links on both hosts, which serve the
                same assetlinks.json. Only the conversation permalink prefix is claimed; MainActivity
                parses the exact /s/{slug}/channel|dm/{id} shape and leaves anything else to the browser.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="app.raft.build" />
                <data android:host="open.raft.build" />
                <data android:pathPrefix="/s/" />
            </intent-filter>
            <!--
                The web origin root only: email verification (`/?verify=`) and the social auth callback
                (`/?auth_callback=social`) land there. Not the whole origin: once app.raft.build is a
                verified App Link host, every path an intent filter names opens the app, and other web
                pages must stay in the browser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="app.slock.ai" />
                <data android:host="app.raft.build" />
                <data android:path="/" />
                <data android:path="" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="${oauthCallbackScheme}" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="login"
                    android:path="/callback"
                    android:scheme="${oauthCallbackScheme}" />
            </intent-filter>
            <!--
                Raft Desktop message links: `raft:///s/{slug}/channel/{cid}?msg={mid}` (empty host) and
                `raft://s/…`. A filter cannot name a path without a host, so this takes the whole app
                scheme; MainActivity converts only /s/{slug}/… to the Developer environment's web link
                (RaftMessageLinkIngress) and opens the app as before for anything else.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${oauthCallbackScheme}" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".shared.RaftUnreadNotificationDismissReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.SlockActivityWidgetProvider"
            android:exported="true"
            android:label="@string/slock_activity_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/raft_activity_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SlockAgentStatusWidgetProvider"
            android:exported="true"
            android:label="@string/slock_agent_status_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/raft_agent_status_widget_info" />
        </receiver>
    </application>

</manifest>

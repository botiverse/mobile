<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <application>
        <!--
            Raft Alpha is usually pointed at staging: claim the staging web host's message links too
            (unverified; staging assetlinks lists only the release package). MainActivity accepts
            them only while the Developer environment's web URL is that host.
        -->
        <activity android:name="build.raft.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="raft-app-staging.botiverse.dev" />
                <data android:pathPrefix="/s/" />
            </intent-filter>
        </activity>
    </application>
</manifest>

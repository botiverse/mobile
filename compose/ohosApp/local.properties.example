# Kuikly Gradle project root, relative to compose/ohosApp.
kuikly.projectPath=../

# Gradle project path used to select the link task.
kuikly.moduleName=ohosBridge

# Kotlin/Native output basename. Defaults to moduleName when omitted.
kuikly.libraryName=shared

kuikly.ohosGradleSettings=settings.ohos.gradle.kts

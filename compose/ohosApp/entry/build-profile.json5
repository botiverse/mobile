{
  "apiType": "stageMode",
  "buildOption": {
    "sourceOption": {
      "workers": [
      ],
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false
          }
        }
      },
      "nativeLib": {
        "debugSymbol": {
          "strip": false,
          "exclude": []
        }
      }
    },
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": true,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      },
      "nativeLib": {
        "debugSymbol": {
          "strip": true,
          "exclude": []
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default",
      // KmmResource generated MR resources (task #19): mr-res is synced from
      // shared/build/generated/tmm-res/ohosArm64Main/mergeRes by the gradle
      // task copyMrResourcesForOhosEntry (compose/build.ohos.gradle.kts) —
      // slock_* string/color/plural keys must reach resources.index or shared
      // stringResource() fails at runtime.
      // MR binary assets are also mirrored into mr-kuikly-assets/resfile/assets
      // because Kuikly's assets:// loader resolves against the resfile root,
      // while KmmResource's native locator remains packaged under rawfile.
      "resource": {
        "directories": [
          "./src/main/resources",
          "./mr-res",
          "./mr-kuikly-assets"
        ]
      }
    },
    {
      "name": "ohosTest",
    }
  ]
}

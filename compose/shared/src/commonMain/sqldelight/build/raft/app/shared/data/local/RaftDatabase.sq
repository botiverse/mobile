  lastSyncedAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMemberSnapshot:
SELECT *
FROM memberProfileEntity
WHERE serverId = ?
  AND id = ?;

updateMemberPresence:
UPDATE memberProfileEntity
SET presence = ?,
    kind = COALESCE(?, kind),
    lastSyncedAtMs = ?
WHERE serverId = ?
  AND id = ?;

updateMemberMembershipStatus:
UPDATE memberProfileEntity
SET membershipStatus = ?,
    lastSyncedAtMs = ?
WHERE serverId = ?
  AND id = ?;

selectAvatarCacheMetadata:
SELECT *
FROM avatarCacheMetadataEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND memberKind = ?;

-- task #343: cold-start prewarm. Only exact committed rows whose resource is not currently
-- suppressed by an unexpired failure; newest validation first, bounded by the caller.
selectCommittedAvatarCacheMetadataForOwner:
SELECT avatarCacheMetadataEntity.*
FROM avatarCacheMetadataEntity
WHERE avatarCacheMetadataEntity.environmentId = :environmentId
  AND avatarCacheMetadataEntity.accountId = :accountId
  AND avatarCacheMetadataEntity.serverId = :serverId
  AND avatarCacheMetadataEntity.commitGeneration IS NOT NULL
  AND avatarCacheMetadataEntity.commitNonce IS NOT NULL
  AND avatarCacheMetadataEntity.modelRevision IS NOT NULL
  AND NOT EXISTS (
    SELECT 1
    FROM avatarCacheFailureEntity
    WHERE avatarCacheFailureEntity.environmentId = avatarCacheMetadataEntity.environmentId
      AND avatarCacheFailureEntity.accountId = avatarCacheMetadataEntity.accountId
      AND avatarCacheFailureEntity.serverId = avatarCacheMetadataEntity.serverId
      AND avatarCacheFailureEntity.subjectKind = avatarCacheMetadataEntity.subjectKind
      AND avatarCacheFailureEntity.subjectId = avatarCacheMetadataEntity.subjectId
      AND avatarCacheFailureEntity.memberKind = avatarCacheMetadataEntity.memberKind
      AND avatarCacheFailureEntity.contentKind = avatarCacheMetadataEntity.contentKind
      AND avatarCacheFailureEntity.contentFingerprint = avatarCacheMetadataEntity.contentFingerprint
      AND avatarCacheFailureEntity.retryAtMs > :nowMs
  )
ORDER BY avatarCacheMetadataEntity.validatedAtMs DESC
LIMIT :limit;

upsertAvatarCacheMetadata:
INSERT OR REPLACE INTO avatarCacheMetadataEntity(
  environmentId, accountId, serverId,
  subjectKind, subjectId, memberKind,
  contentKind, contentFingerprint,
  eTag, lastModified,
  fetchedAtMs, validatedAtMs, freshUntilMs, staleUntilMs,
  sizeBytes, contentType,
  commitGeneration, commitNonce, modelRevision
) SELECT
  :environmentId, :accountId, :serverId,
  :subjectKind, :subjectId, :memberKind,
  :contentKind, :contentFingerprint,
  :eTag, :lastModified,
  :fetchedAtMs, :validatedAtMs, :freshUntilMs, :staleUntilMs,
  :sizeBytes, :contentType,
  :commitGeneration, :commitNonce, :modelRevision
WHERE
  (:commitGeneration IS NULL AND :commitNonce IS NULL AND :modelRevision IS NULL)
  OR (:commitGeneration IS NOT NULL AND :commitNonce IS NOT NULL AND :modelRevision IS NOT NULL);

deleteAvatarCacheMetadata:
DELETE FROM avatarCacheMetadataEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND memberKind = ?;

deleteAvatarCacheMetadataForContent:
DELETE FROM avatarCacheMetadataEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND memberKind = ?
  AND contentKind = ?
  AND contentFingerprint = ?;

selectAvatarCacheFailure:
SELECT *
FROM avatarCacheFailureEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND memberKind = ?
  AND contentKind = ?
  AND contentFingerprint = ?;

upsertAvatarCacheFailure:
INSERT OR REPLACE INTO avatarCacheFailureEntity(
  environmentId, accountId, serverId,
  subjectKind, subjectId, memberKind,
  contentKind, contentFingerprint,
  failureKind, consecutiveCount, failedAtMs, retryAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAvatarCacheFailure:
DELETE FROM avatarCacheFailureEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND memberKind = ?
  AND contentKind = ?
  AND contentFingerprint = ?;

deleteAvatarCacheFailuresForSubject:
DELETE FROM avatarCacheFailureEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND memberKind = ?;

clearAvatarCacheMetadataForOwner:
DELETE FROM avatarCacheMetadataEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?;

clearAvatarCacheFailuresForOwner:
DELETE FROM avatarCacheFailureEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?;

clearTemporaryAvatarCacheFailuresForOwner:
DELETE FROM avatarCacheFailureEntity
WHERE environmentId = ?
  AND accountId = ?
  AND serverId = ?
  AND failureKind = ?;

clearAllAvatarCacheMetadata:
DELETE FROM avatarCacheMetadataEntity;

clearAllAvatarCacheFailures:
DELETE FROM avatarCacheFailureEntity;

updateThreadMetadata:
UPDATE channelEntity
SET replyCount = ?,
    updatedAtLabel = COALESCE(?, updatedAtLabel),
    lastSyncedAtMs = ?
WHERE serverId = ?
  AND type = 'thread'
  AND parentMessageId = ?;

clearChannelUnread:
UPDATE channelEntity
SET unreadCount = 0,
    mentionCount = 0,
    firstUnreadMessageId = NULL,
    lastSyncedAtMs = ?
WHERE serverId = ?
  AND channelId = ?;

upsertSyncCursor:
INSERT OR REPLACE INTO syncCursorEntity(
  scopeId,
  environmentId,
  serverId,
  principalId,
  consumerId,
  scopeKind,
  latestSeq,
  oldestLoadedSeq,
  newestLoadedSeq,
  hasLoadedOldest,
  hasLoadedNewest,
  updatedAtMs,
  epoch,
  parentScopeKind,
  parentScopeId,
  rootMessageId,
  lastUserAccessAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSyncCursor:
SELECT *
FROM syncCursorEntity
WHERE serverId = ?
  AND environmentId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?;

-- Offline read entry (task #1123): a thread screen enters by channel id alone and must resolve the
-- persisted scopeKind before it can restore the scope. Only a committed cursor row proves a baseline
-- exists; a scope with facts but no cursor is poisoned, not readable.
selectSyncCursorScopeKindsForScopeId:
SELECT scopeKind
FROM syncCursorEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeId = ?
ORDER BY scopeKind;

-- #491 P1 warm-start restore: canonical server-backed timeline read. Only server-backed rows
-- (seq IS NOT NULL) in (seq, id) tie-break order — NOT selectMessagesForChannel, which sorts by
-- timestampLabel. Sparse seq orders only; it never synthesizes dense successors.
-- T-wrapper restore: a scope's canonical facts in (seq, id) tie-break order. No `seq IS NOT NULL` filter —
-- `seq` is NOT NULL by schema (pending/optimistic never enter this table), so the filter would be a
-- tautology that misleads readers into thinking seq-null rows still exist here.
selectServerBackedMessagesForChannel:
SELECT *
FROM messageEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?
ORDER BY seq, id;

-- A use of the scope: both the write time and the user-access time (schema v10) move.
touchSyncCursorUserAccess:
UPDATE syncCursorEntity
SET updatedAtMs = :atMs, lastUserAccessAtMs = :atMs
WHERE environmentId = :environmentId
  AND serverId = :serverId
  AND principalId = :principalId
  AND consumerId = :consumerId
  AND scopeKind = :scopeKind
  AND scopeId = :scopeId;

deleteSyncCursorForScope:
DELETE FROM syncCursorEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?;

clearCanonicalFactsForPartition:
DELETE FROM messageEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?;

clearSyncCursorsForPartition:
DELETE FROM syncCursorEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?;

clearMessageViewerOverlaysForPartition:
DELETE FROM messageViewerOverlayEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?;

-- Retired-consumer purge (message storage Phase 0a): every partition's rows of one consumer that no
-- longer has a writer or reader (sync-core.messages.v1).
purgeCanonicalFactsForConsumer:
DELETE FROM messageEntity
WHERE consumerId = ?;

purgeSyncCursorsForConsumer:
DELETE FROM syncCursorEntity
WHERE consumerId = ?;

purgeMessageViewerOverlaysForConsumer:
DELETE FROM messageViewerOverlayEntity
WHERE consumerId = ?;

selectCanonicalScopeRetentionStats:
SELECT
  cursor.scopeKind,
  cursor.scopeId,
  cursor.updatedAtMs,
  cursor.lastUserAccessAtMs,
  COUNT(message.id) AS factCount,
  COALESCE(SUM(LENGTH(message.canonicalFactJson)), 0) AS byteCount
FROM syncCursorEntity AS cursor
LEFT JOIN messageEntity AS message
  ON message.environmentId = cursor.environmentId
  AND message.serverId = cursor.serverId
  AND message.principalId = cursor.principalId
  AND message.consumerId = cursor.consumerId
  AND message.scopeKind = cursor.scopeKind
  AND message.channelId = cursor.scopeId
WHERE cursor.environmentId = ?
  AND cursor.serverId = ?
  AND cursor.principalId = ?
  AND cursor.consumerId = ?
GROUP BY cursor.scopeKind, cursor.scopeId, cursor.updatedAtMs, cursor.lastUserAccessAtMs
-- Most recently used first: by user access (schema v10; never-opened scopes last), then last write.
ORDER BY (cursor.lastUserAccessAtMs IS NULL), cursor.lastUserAccessAtMs DESC, cursor.updatedAtMs DESC,
  cursor.scopeKind, cursor.scopeId;

selectCanonicalFactIdsBeyondLimit:
SELECT fact.id, fact.seq
FROM messageEntity AS fact
WHERE fact.environmentId = ?
  AND fact.serverId = ?
  AND fact.principalId = ?
  AND fact.consumerId = ?
  AND fact.scopeKind = ?
  AND fact.channelId = ?
  AND NOT EXISTS (
    SELECT 1
    FROM syncCursorEntity AS reply
    WHERE reply.environmentId = fact.environmentId
      AND reply.serverId = fact.serverId
      AND reply.principalId = fact.principalId
      AND reply.consumerId = fact.consumerId
      AND reply.scopeKind = 'thread'
      AND reply.parentScopeKind = fact.scopeKind
      AND reply.parentScopeId = fact.channelId
      AND reply.rootMessageId = fact.id
  )
ORDER BY fact.seq DESC, fact.id DESC
LIMIT -1 OFFSET ?;

-- The oldest fact of a V2 scope above [seq]: after the per-scope cap prunes the oldest end, the window's
-- oldest edge moves here (the oldest fact newer than everything pruned).
selectOldestCanonicalFactSeqAbove:
SELECT MIN(seq) AS oldestSeq
FROM messageEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?
  AND seq > ?;

selectReplyScopesDependingOnParent:
SELECT scopeKind, scopeId
FROM syncCursorEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = 'thread'
  AND parentScopeKind = ?
  AND parentScopeId = ?;

selectCanonicalMessageV2Partitions:
SELECT environmentId, serverId, principalId, consumerId FROM messageEntity
WHERE consumerId = ?
UNION
SELECT environmentId, serverId, principalId, consumerId FROM syncCursorEntity
WHERE consumerId = ?
UNION
SELECT environmentId, serverId, principalId, consumerId FROM messageViewerOverlayEntity
WHERE consumerId = ?
UNION
SELECT environmentId, serverId, principalId, consumerId FROM messageSegmentEntity
WHERE consumerId = ?
ORDER BY environmentId, principalId, serverId, consumerId;

insertOutboxMessage:
INSERT INTO outboxMessageEntity(
  localId,
  serverId,
  channelId,
  body,
  attachmentIdsJson,
  asTask,
  status,
  createdAtMs,
  lastErrorCode
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateOutboxStatus:
UPDATE outboxMessageEntity
SET status = ?, lastErrorCode = ?
WHERE localId = ?;

selectPendingOutboxMessages:
SELECT *
FROM outboxMessageEntity
WHERE serverId = ?
  AND status IN ('pending', 'failed')
ORDER BY createdAtMs, localId;

insertThreadPendingSend:
INSERT INTO threadPendingSendEntity(
  environmentId,
  principalId,
  serverId,
  ownerScopeId,
  authGeneration,
  selectionGeneration,
  routeInstanceKey,
  routeSurfaceKind,
  routeChannelKind,
  routeParentConversationKind,
  routeTimelineKey,
  routeParentKey,
  localId,
  randomId,
  messageJson,
  pendingContextJson,
  status,
  createdAtMs,
  lastErrorCode,
  lastErrorMessage
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateThreadPendingSendSending:
UPDATE threadPendingSendEntity
SET messageJson = ?,
  pendingContextJson = ?,
  status = 'sending',
  createdAtMs = ?,
  lastErrorCode = NULL,
  lastErrorMessage = NULL
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND ownerScopeId = ?
  AND authGeneration = ?
  AND selectionGeneration = ?
  AND routeInstanceKey = ?
  AND localId = ?
  AND randomId = ?;

selectThreadPendingSends:
SELECT *
FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND ownerScopeId = ?
  AND authGeneration = ?
  AND selectionGeneration = ?
  AND routeInstanceKey = ?
ORDER BY createdAtMs, localId;

selectThreadPendingSendCandidates:
SELECT *
FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND ownerScopeId = ?
  AND authGeneration = ?
  AND selectionGeneration = ?
ORDER BY createdAtMs, localId;

updateThreadPendingSendFailure:
UPDATE threadPendingSendEntity
SET status = 'failed', lastErrorCode = ?, lastErrorMessage = ?
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND ownerScopeId = ?
  AND authGeneration = ?
  AND selectionGeneration = ?
  AND routeInstanceKey = ?
  AND localId = ?;

deleteThreadPendingSend:
DELETE FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND ownerScopeId = ?
  AND authGeneration = ?
  AND selectionGeneration = ?
  AND routeInstanceKey = ?
  AND localId = ?;

deleteThreadPendingSendByRandomId:
DELETE FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND ownerScopeId = ?
  AND authGeneration = ?
  AND selectionGeneration = ?
  AND routeInstanceKey = ?
  AND randomId = ?;

-- Drain-path visibility: durable rows belong to a stable identity (environment,
-- account, server). Generation/scope columns only fence in-process concurrent
-- writes, never whether a journaled orphan can be seen and adopted.
selectThreadPendingSendForStableIdentity:
SELECT *
FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
ORDER BY createdAtMs, localId;

updateThreadPendingSendFailureForStableIdentity:
UPDATE threadPendingSendEntity
SET status = 'failed', lastErrorCode = ?, lastErrorMessage = ?
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND routeInstanceKey = ?
  AND localId = ?;

deleteThreadPendingSendByRandomIdForStableIdentity:
DELETE FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND serverId = ?
  AND routeInstanceKey = ?
  AND randomId = ?;

deleteThreadPendingSendsForAuthRevision:
DELETE FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND authGeneration = ?;

selectThreadPendingSendsForAuthRevision:
SELECT *
FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND authGeneration = ?;

-- Same-binding token rotation: move rows into the successor auth revision instead of
-- deleting them, so a journaled pending send stays reachable after a 401 refresh.
-- ownerScopeId embeds authGeneration, so both columns must move together; the per-row
-- selectionGeneration component is recomputed by the caller from the row itself.
rehomeThreadPendingSendAuthRevision:
UPDATE threadPendingSendEntity
SET authGeneration = :newAuthGeneration,
    ownerScopeId = :newOwnerScopeId
WHERE environmentId = :environmentId
  AND principalId = :principalId
  AND serverId = :serverId
  AND ownerScopeId = :oldOwnerScopeId
  AND authGeneration = :oldAuthGeneration
  AND selectionGeneration = :selectionGeneration
  AND routeInstanceKey = :routeInstanceKey
  AND localId = :localId;

deleteThreadPendingSendsForPrincipalBeforeAuthRevision:
DELETE FROM threadPendingSendEntity
WHERE environmentId = ?
  AND principalId = ?
  AND authGeneration < ?;

selectSnapshot:
SELECT value
FROM localSnapshotEntity
WHERE scope = ?
  AND id = ?
LIMIT 1;

upsertSnapshot:
INSERT OR REPLACE INTO localSnapshotEntity(
  scope,
  id,
  value,
  updatedAtMs
) VALUES (?, ?, ?, ?);

deleteSnapshot:
DELETE FROM localSnapshotEntity
WHERE scope = ?
  AND id = ?;

selectSnapshotIds:
SELECT id
FROM localSnapshotEntity
WHERE scope = ?;

selectSnapshotWithTime:
SELECT value, updatedAtMs
FROM localSnapshotEntity
WHERE scope = ?
  AND id = ?
LIMIT 1;

selectSnapshotRowTimes:
SELECT id, updatedAtMs
FROM localSnapshotEntity
WHERE scope = ?;

deleteSnapshotScope:
DELETE FROM localSnapshotEntity
WHERE scope = ?;

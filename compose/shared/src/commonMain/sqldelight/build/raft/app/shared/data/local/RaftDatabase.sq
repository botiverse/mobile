-- Server channel metadata. Server-side threads are also rows in channels with
-- type = 'thread' and parentMessageId set.
CREATE TABLE channelEntity (
  serverId TEXT NOT NULL,
  channelId TEXT NOT NULL,
  type TEXT NOT NULL,
  name TEXT NOT NULL,
  description TEXT,
  parentChannelId TEXT,
  parentMessageId TEXT,
  avatarUrl TEXT,
  presenceMemberId TEXT,
  joined INTEGER NOT NULL DEFAULT 1,
  archived INTEGER NOT NULL DEFAULT 0,
  memberCount INTEGER,
  unreadCount INTEGER NOT NULL DEFAULT 0,
  mentionCount INTEGER NOT NULL DEFAULT 0,
  lastMessageId TEXT,
  firstUnreadMessageId TEXT,
  lastMessagePreview TEXT,
  lastMessageSenderName TEXT,
  hasDraft INTEGER NOT NULL DEFAULT 0,
  replyCount INTEGER NOT NULL DEFAULT 0,
  jointChannelId TEXT,
  jointRole TEXT,
  jointPeerServerId TEXT,
  jointPeerServerName TEXT,
  jointPeerServerSlug TEXT,
  jointPeerStatus TEXT,
  -- Bit mask for channel-level permissions:
  -- 1 = read, 2 = send, 4 = attach, 8 = create task.
  capabilities INTEGER NOT NULL DEFAULT 15,
  updatedAtLabel TEXT,
  lastSyncedAtMs INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (serverId, channelId)
);

CREATE INDEX channelEntity_serverType ON channelEntity(serverId, type);
CREATE INDEX channelEntity_parentMessageId ON channelEntity(serverId, parentMessageId);
CREATE INDEX channelEntity_parentChannelId ON channelEntity(serverId, parentChannelId);

-- Stable aliases for resolving channel/thread/member-facing ids to the
-- canonical channelEntity row used by the conversation directory facade.
CREATE TABLE conversationAliasEntity (
  serverId TEXT NOT NULL,
  aliasId TEXT NOT NULL,
  aliasKind TEXT NOT NULL,
  canonicalChannelId TEXT NOT NULL,
  lastSyncedAtMs INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (serverId, aliasId, aliasKind),
  FOREIGN KEY (serverId, canonicalChannelId)
    REFERENCES channelEntity(serverId, channelId)
    ON DELETE CASCADE
);

CREATE INDEX conversationAliasEntity_alias ON conversationAliasEntity(serverId, aliasId);
CREATE INDEX conversationAliasEntity_canonical ON conversationAliasEntity(serverId, canonicalChannelId);

-- Per-principal read and inbox state for normal channels, private channels,
-- and DMs. Thread follow/done state lives in threadFollowEntity.
CREATE TABLE channelReadStateEntity (
  serverId TEXT NOT NULL,
  channelId TEXT NOT NULL,
  principalKind TEXT NOT NULL,
  principalId TEXT NOT NULL,
  lastReadSeq INTEGER NOT NULL DEFAULT 0,
  lastReadMessageId TEXT,
  lastViewedAtMs INTEGER,
  doneAtMs INTEGER,
  updatedAtMs INTEGER NOT NULL,
  lastSyncedAtMs INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (serverId, channelId, principalKind, principalId)
);

CREATE INDEX channelReadStateEntity_principal ON channelReadStateEntity(serverId, principalKind, principalId);

-- Thread inbox/follow state. A thread is a channel row, but its attention state
-- follows server thread_follows rather than channel membership.
CREATE TABLE threadFollowEntity (
  serverId TEXT NOT NULL,
  threadChannelId TEXT NOT NULL,
  followerKind TEXT NOT NULL,
  followerId TEXT NOT NULL,
  parentMessageId TEXT NOT NULL,
  reason TEXT NOT NULL,
  doneAtMs INTEGER,
  unfollowedAtMs INTEGER,
  createdAtMs INTEGER,
  lastSyncedAtMs INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (serverId, threadChannelId, followerKind, followerId)
);

CREATE INDEX threadFollowEntity_follower ON threadFollowEntity(serverId, followerKind, followerId);
CREATE INDEX threadFollowEntity_parentMessageId ON threadFollowEntity(serverId, parentMessageId);

-- Message body cache. channelId is the current message-list channel. For
-- thread replies this is the id of the thread channel row.
-- T-wrapper canonical-native fact store (RFC 043 §9.9). One row = one canonical SERVER fact:
-- `canonicalFactJson` (versioned envelope, CanonicalFactCodec) is the LOSSLESS restore/continuation source
-- of truth; the remaining columns are ONLY the minimal query/sort scalars a SQL read needs. No presentation
-- state is persisted (author display / body / timestamp label / delivery are projected at read time via
-- CanonicalMessageRow.toAppMessage). Pending/optimistic/outbox rows NEVER enter this table — `seq NOT NULL`
-- makes that structural, so `clearScope` is a plain full-scope delete (no exceptions).
-- `unknownFields` (schema v9, task #14a): the aggregates a V2 fact written from a realtime frame does not
-- know (comma-separated, canonical order); NULL = all known. The fact's bytes hold neutral placeholders
-- for them, and unknown is never read as empty.
-- `localRev` (schema v10): the scope-local write revision of the fact's last write (0 = written before v10).
-- A page whose request started at revision R never overwrites a fact with localRev > R.
CREATE TABLE messageEntity (
  environmentId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  consumerId TEXT NOT NULL,
  id TEXT NOT NULL,
  channelId TEXT NOT NULL,
  scopeKind TEXT NOT NULL,
  seq INTEGER NOT NULL,
  createdAt TEXT NOT NULL,
  canonicalFactJson TEXT NOT NULL,
  unknownFields TEXT,
  localRev INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (environmentId, serverId, principalId, consumerId, id)
);

-- Canonical (seq, id) tie-break order for server-backed restore/timeline reads (#491 P1).
CREATE INDEX messageEntity_partitionChannelSeqId
ON messageEntity(environmentId, serverId, principalId, consumerId, scopeKind, channelId, seq, id);

-- Receiver-private authoritative overlay. It has a separate owner and restore lifecycle from messageEntity:
-- shared room frames cannot write this table, and overlay compare+write runs in its own transaction.
CREATE TABLE messageViewerOverlayEntity (
  environmentId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  consumerId TEXT NOT NULL,
  scopeKind TEXT NOT NULL,
  scopeId TEXT NOT NULL,
  subjectKind TEXT NOT NULL,
  subjectId TEXT NOT NULL,
  overlayKind TEXT NOT NULL,
  overlayVersion INTEGER NOT NULL,
  completeness TEXT NOT NULL,
  payloadJson TEXT NOT NULL,
  PRIMARY KEY (
    environmentId, serverId, principalId, consumerId,
    scopeKind, scopeId,
    subjectKind, subjectId, overlayKind
  )
);

-- Independent authoritative owner read-state fact family. This table is intentionally disjoint from both
-- messageEntity (sync-core.messages.v2) and channelReadStateEntity (presentation/inbox projection).
CREATE TABLE syncReadStateFactEntity (
  serverId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  consumerId TEXT NOT NULL,
  channelId TEXT NOT NULL,
  readStateVersion INTEGER NOT NULL,
  maxReadSeq INTEGER NOT NULL,
  updatedAtMs INTEGER NOT NULL,
  PRIMARY KEY (serverId, principalId, consumerId, channelId)
);

-- attachmentEntity / messageReactionEntity / savedMessageEntity were removed with the canonical-native
-- rebuild: all three had zero live consumers, and the canonical fact (attachments, reactions) is stored
-- losslessly in messageEntity.canonicalFactJson. Maintaining them would be a second materialized projection
-- (reactions don't even map cleanly — per-reactor rows vs per-emoji aggregate) with CASCADE/drift surface
-- and no verifiable benefit. A future SQL consumer reintroduces one WITH its projector + consistency gate.
CREATE TABLE taskSummaryEntity (
  id TEXT NOT NULL PRIMARY KEY,
  serverId TEXT NOT NULL,
  messageId TEXT,
  parentMessageId TEXT,
  channelId TEXT,
  title TEXT NOT NULL,
  status TEXT NOT NULL,
  taskNumber INTEGER,
  isThreadTask INTEGER NOT NULL DEFAULT 0,
  assigneeId TEXT,
  assigneeDisplayName TEXT,
  assigneeHandle TEXT,
  assigneeKind TEXT,
  channelName TEXT,
  updatedAtLabel TEXT NOT NULL,
  -- Bit mask for task row actions: 1 = claim.
  capabilities INTEGER NOT NULL DEFAULT 1,
  lastSyncedAtMs INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX taskSummaryEntity_messageId ON taskSummaryEntity(messageId);
CREATE INDEX taskSummaryEntity_parentMessageId ON taskSummaryEntity(parentMessageId);
CREATE INDEX taskSummaryEntity_taskNumber ON taskSummaryEntity(taskNumber);
CREATE INDEX taskSummaryEntity_serverId ON taskSummaryEntity(serverId);
CREATE INDEX taskSummaryEntity_channelId ON taskSummaryEntity(serverId, channelId);

CREATE TABLE memberProfileEntity (
  id TEXT NOT NULL,
  serverId TEXT NOT NULL,
  displayName TEXT NOT NULL,
  handle TEXT NOT NULL,
  kind TEXT NOT NULL,
  avatarUrl TEXT,
  avatarLabel TEXT,
  presence TEXT,
  description TEXT,
  roleDescription TEXT,
  membershipStatus TEXT,
  lastSyncedAtMs INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (serverId, id)
);

CREATE INDEX memberProfileEntity_membershipStatus ON memberProfileEntity(serverId, membershipStatus);

-- Durable avatar policy only. Native platform caches remain the sole owners of image bytes and
-- decoded images; no file path, blob, URL, or route/pageData content belongs in these tables.
CREATE TABLE avatarCacheMetadataEntity (
  environmentId TEXT NOT NULL,
  accountId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  subjectKind TEXT NOT NULL,
  subjectId TEXT NOT NULL,
  memberKind TEXT NOT NULL,
  contentKind TEXT NOT NULL,
  contentFingerprint TEXT NOT NULL,
  eTag TEXT,
  lastModified TEXT,
  fetchedAtMs INTEGER NOT NULL,
  validatedAtMs INTEGER NOT NULL,
  freshUntilMs INTEGER NOT NULL,
  staleUntilMs INTEGER NOT NULL,
  sizeBytes INTEGER NOT NULL,
  contentType TEXT,
  commitGeneration INTEGER,
  commitNonce TEXT,
  modelRevision INTEGER,
  PRIMARY KEY (environmentId, accountId, serverId, subjectKind, subjectId, memberKind)
);

-- Failure state is exact-resource scoped, never host-only, so one broken avatar cannot suppress
-- unrelated valid resources.
CREATE TABLE avatarCacheFailureEntity (
  environmentId TEXT NOT NULL,
  accountId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  subjectKind TEXT NOT NULL,
  subjectId TEXT NOT NULL,
  memberKind TEXT NOT NULL,
  contentKind TEXT NOT NULL,
  contentFingerprint TEXT NOT NULL,
  failureKind TEXT NOT NULL,
  consecutiveCount INTEGER NOT NULL,
  failedAtMs INTEGER NOT NULL,
  retryAtMs INTEGER NOT NULL,
  PRIMARY KEY (
    environmentId, accountId, serverId, subjectKind, subjectId, memberKind,
    contentKind, contentFingerprint
  )
);

CREATE TABLE syncCursorEntity (
  scopeId TEXT NOT NULL,
  environmentId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  consumerId TEXT NOT NULL,
  scopeKind TEXT NOT NULL,
  latestSeq INTEGER,
  oldestLoadedSeq INTEGER,
  newestLoadedSeq INTEGER,
  hasLoadedOldest INTEGER NOT NULL DEFAULT 0,
  hasLoadedNewest INTEGER NOT NULL DEFAULT 1,
  updatedAtMs INTEGER NOT NULL,
  epoch TEXT,
  parentScopeKind TEXT,
  parentScopeId TEXT,
  rootMessageId TEXT,
  -- Schema v10: when the user last read or loaded the scope (retention rank); NULL = never opened.
  lastUserAccessAtMs INTEGER,
  -- Full durable partition + scope key: a channel and a thread (etc.) that happen to share a partition and
  -- scopeId must not collide on the cursor. scopeKind is part of the identity, so it is in the PK.
  PRIMARY KEY (environmentId, serverId, principalId, consumerId, scopeKind, scopeId)
);

CREATE INDEX syncCursorEntity_partitionUpdatedScope
ON syncCursorEntity(environmentId, serverId, principalId, consumerId, updatedAtMs DESC, scopeKind, scopeId);

-- Schema v10 (message storage design 2026-10-27): one row = one proven-complete seq range [lowSeq, highSeq]
-- of a V2 scope — every message of the scope with a seq in the range is stored. A scope's segments never
-- overlap or touch (they are merged in the writing transaction); gaps are derived at read time. A
-- `reachesOldest` segment also proves nothing exists below it. [0, 0] + reachesOldest = known-empty scope.
-- The syncCursorEntity window columns mirror the head segment (the one with the highest highSeq).
CREATE TABLE messageSegmentEntity (
  environmentId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  consumerId TEXT NOT NULL,
  scopeKind TEXT NOT NULL,
  scopeId TEXT NOT NULL,
  lowSeq INTEGER NOT NULL,
  highSeq INTEGER NOT NULL,
  reachesOldest INTEGER NOT NULL,
  headAtVerify INTEGER NOT NULL,
  verifiedAtMs INTEGER NOT NULL,
  source TEXT NOT NULL,
  PRIMARY KEY (environmentId, serverId, principalId, consumerId, scopeKind, scopeId, lowSeq)
);

-- Schema v10: the partition's fact write revision (messageEntity.localRev of its newest write). It only
-- grows — no retention, scope clear or partition clear lowers or deletes it — so a fact written after a
-- request started always has localRev > the revision the request read.
CREATE TABLE messageLocalRevEntity (
  environmentId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  consumerId TEXT NOT NULL,
  localRev INTEGER NOT NULL,
  PRIMARY KEY (environmentId, serverId, principalId, consumerId)
);

CREATE TABLE outboxMessageEntity (
  localId TEXT NOT NULL PRIMARY KEY,
  serverId TEXT NOT NULL,
  channelId TEXT NOT NULL,
  body TEXT NOT NULL,
  attachmentIdsJson TEXT NOT NULL DEFAULT '[]',
  asTask INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL,
  createdAtMs INTEGER NOT NULL,
  lastErrorCode TEXT
);

-- Thread sends are a separate, identity-bound journal.  Unlike the legacy
-- outbox row above this stores the exact optimistic projection and send
-- context needed to restore a Thread after a process/page rebuild.  It is
-- deliberately not part of messageEntity: pending rows are client intent,
-- not canonical server facts.
CREATE TABLE threadPendingSendEntity (
  environmentId TEXT NOT NULL,
  principalId TEXT NOT NULL,
  serverId TEXT NOT NULL,
  ownerScopeId TEXT NOT NULL,
  authGeneration INTEGER NOT NULL,
  selectionGeneration INTEGER NOT NULL,
  routeInstanceKey TEXT NOT NULL,
  routeSurfaceKind TEXT NOT NULL,
  routeChannelKind TEXT,
  routeParentConversationKind TEXT,
  routeTimelineKey TEXT,
  routeParentKey TEXT,
  localId TEXT NOT NULL,
  randomId TEXT NOT NULL,
  messageJson TEXT NOT NULL,
  pendingContextJson TEXT NOT NULL,
  status TEXT NOT NULL,
  createdAtMs INTEGER NOT NULL,
  lastErrorCode TEXT,
  lastErrorMessage TEXT,
  PRIMARY KEY (
    environmentId,
    principalId,
    serverId,
    ownerScopeId,
    authGeneration,
    selectionGeneration,
    routeInstanceKey,
    localId
  )
);

CREATE INDEX threadPendingSendEntity_identityRoute
ON threadPendingSendEntity(
  environmentId,
  principalId,
  serverId,
  ownerScopeId,
  authGeneration,
  selectionGeneration,
  routeInstanceKey,
  createdAtMs,
  localId
);

CREATE UNIQUE INDEX threadPendingSendEntity_randomId
ON threadPendingSendEntity(
  environmentId,
  principalId,
  serverId,
  ownerScopeId,
  authGeneration,
  selectionGeneration,
  randomId
);

CREATE TABLE localSnapshotEntity (
  scope TEXT NOT NULL,
  id TEXT NOT NULL,
  value TEXT NOT NULL,
  updatedAtMs INTEGER NOT NULL,
  PRIMARY KEY(scope, id)
);

selectChannel:
SELECT *
FROM channelEntity
WHERE serverId = ?
  AND channelId = ?
LIMIT 1;

selectSyncReadStateFact:
SELECT *
FROM syncReadStateFactEntity
WHERE serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND channelId = ?
LIMIT 1;

upsertSyncReadStateFact:
INSERT OR REPLACE INTO syncReadStateFactEntity(
  serverId,
  principalId,
  consumerId,
  channelId,
  readStateVersion,
  maxReadSeq,
  updatedAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSyncReadStateFactsForPartition:
DELETE FROM syncReadStateFactEntity
WHERE serverId = ?
  AND principalId = ?
  AND consumerId = ?;

selectChannelServerId:
SELECT serverId
FROM channelEntity
WHERE channelId = ?
LIMIT 1;

selectHomeChannels:
SELECT *
FROM channelEntity
WHERE serverId = ?
  AND type != 'thread'
ORDER BY CASE type
  WHEN 'channel' THEN 0
  WHEN 'private' THEN 1
  WHEN 'dm' THEN 2
  ELSE 3
END,
name COLLATE NOCASE ASC,
channelId ASC;

selectConversationDirectory:
SELECT *
FROM channelEntity
WHERE serverId = ?
ORDER BY channelId ASC;

selectConversationAliasesForServer:
SELECT *
FROM conversationAliasEntity
WHERE serverId = ?
ORDER BY aliasId ASC,
         aliasKind ASC;

selectConversationAliasesForId:
SELECT *
FROM conversationAliasEntity
WHERE serverId = ?
  AND aliasId = ?
ORDER BY aliasKind ASC;

deleteConversationAliasesForCanonical:
DELETE FROM conversationAliasEntity
WHERE serverId = ?
  AND canonicalChannelId = ?;

selectThreadForParentMessage:
SELECT *
FROM channelEntity
WHERE serverId = ?
  AND type = 'thread'
  AND parentMessageId = ?
LIMIT 1;

selectThreadsForParentChannel:
SELECT *
FROM channelEntity
WHERE serverId = ?
  AND type = 'thread'
  AND parentChannelId = ?
ORDER BY COALESCE(updatedAtLabel, '') DESC,
         channelId ASC;

deleteHomeChannel:
DELETE FROM channelEntity
WHERE serverId = ?
  AND channelId = ?
  AND type != 'thread';

upsertChannel:
INSERT OR REPLACE INTO channelEntity(
  serverId,
  channelId,
  type,
  name,
  description,
  parentChannelId,
  parentMessageId,
  avatarUrl,
  presenceMemberId,
  joined,
  archived,
  memberCount,
  unreadCount,
  mentionCount,
  lastMessageId,
  firstUnreadMessageId,
  lastMessagePreview,
  lastMessageSenderName,
  hasDraft,
  replyCount,
  jointChannelId,
  jointRole,
  jointPeerServerId,
  jointPeerServerName,
  jointPeerServerSlug,
  jointPeerStatus,
  capabilities,
  updatedAtLabel,
  lastSyncedAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertConversationAlias:
INSERT OR REPLACE INTO conversationAliasEntity(
  serverId,
  aliasId,
  aliasKind,
  canonicalChannelId,
  lastSyncedAtMs
) VALUES (?, ?, ?, ?, ?);

selectChannelReadState:
SELECT *
FROM channelReadStateEntity
WHERE serverId = ?
  AND channelId = ?
  AND principalKind = ?
  AND principalId = ?
LIMIT 1;

upsertChannelReadState:
INSERT OR REPLACE INTO channelReadStateEntity(
  serverId,
  channelId,
  principalKind,
  principalId,
  lastReadSeq,
  lastReadMessageId,
  lastViewedAtMs,
  doneAtMs,
  updatedAtMs,
  lastSyncedAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteChannelReadState:
DELETE FROM channelReadStateEntity
WHERE serverId = ?
  AND channelId = ?
  AND principalKind = ?
  AND principalId = ?;

selectThreadFollow:
SELECT *
FROM threadFollowEntity
WHERE serverId = ?
  AND threadChannelId = ?
  AND followerKind = ?
  AND followerId = ?
LIMIT 1;

selectThreadFollowsForFollower:
SELECT *
FROM threadFollowEntity
WHERE serverId = ?
  AND followerKind = ?
  AND followerId = ?
  AND unfollowedAtMs IS NULL
ORDER BY COALESCE(doneAtMs, -1) ASC,
         COALESCE(createdAtMs, 0) DESC,
         threadChannelId ASC;

upsertThreadFollow:
INSERT OR REPLACE INTO threadFollowEntity(
  serverId,
  threadChannelId,
  followerKind,
  followerId,
  parentMessageId,
  reason,
  doneAtMs,
  unfollowedAtMs,
  createdAtMs,
  lastSyncedAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteThreadFollow:
DELETE FROM threadFollowEntity
WHERE serverId = ?
  AND threadChannelId = ?
  AND followerKind = ?
  AND followerId = ?;


-- T-wrapper canonical fact upsert, done as INSERT-OR-IGNORE + scoped UPDATE because the SqlDelight SQLite
-- dialect does not parse `ON CONFLICT ... DO UPDATE`. The pair (run in this order, in one transaction) is an
-- in-place upsert: OR IGNORE creates the row when absent (an id conflict is ignored, NOT replaced), and the
-- UPDATE sets the canonical facts for both the new and the pre-existing row. The UPDATE is SCOPED to the full
-- partition+scopeKind+channelId, so a (contractually impossible) same-partition cross-scope id collision
-- updates 0 rows
-- rather than another scope's fact — the store then fail-stops on that 0-row result.
insertCanonicalFactIfAbsent:
INSERT OR IGNORE INTO messageEntity(
  environmentId,
  serverId,
  principalId,
  consumerId,
  id,
  channelId,
  scopeKind,
  seq,
  createdAt,
  canonicalFactJson
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCanonicalFact:
UPDATE messageEntity
SET seq = ?, createdAt = ?, canonicalFactJson = ?
WHERE id = ?
  AND environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?;

-- Task #14a: one stored fact of THIS full scope (partial merge / completion), read inside the write
-- transaction. 0 rows = absent (or a contractually impossible cross-scope id).
selectCanonicalFactInScope:
SELECT canonicalFactJson, unknownFields, localRev FROM messageEntity
WHERE id = ?
  AND environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?;

-- Task #14a: the unknown-aggregate marker of one fact, written right after its upsert in the same
-- transaction. NULL = every aggregate known. Schema v10: with the fact's write revision (`localRev`).
setCanonicalFactUnknownFields:
UPDATE messageEntity
SET unknownFields = ?, localRev = ?
WHERE id = ?
  AND environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?;

-- Schema v10: the partition's current fact write revision (0 = none yet). A writer reads it before its request.
selectLocalRev:
SELECT COALESCE(MAX(localRev), 0) AS localRev FROM messageLocalRevEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?;

setLocalRev:
INSERT OR REPLACE INTO messageLocalRevEntity(environmentId, serverId, principalId, consumerId, localRev)
VALUES (?, ?, ?, ?, ?);

purgeLocalRevForConsumer:
DELETE FROM messageLocalRevEntity
WHERE consumerId = ?;

-- Schema v10: the oldest / newest stored fact seq of a scope inside [low, high] (the head mirror's edges).
selectFactSeqBoundsInRange:
SELECT MIN(seq) AS oldestSeq, MAX(seq) AS newestSeq FROM messageEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?
  AND seq BETWEEN ? AND ?;

-- Schema v10 reads: the newest facts strictly below / the oldest strictly above a seq, in (seq, id) order.
selectFactsInScopeBefore:
SELECT * FROM messageEntity
WHERE environmentId = :environmentId
  AND serverId = :serverId
  AND principalId = :principalId
  AND consumerId = :consumerId
  AND scopeKind = :scopeKind
  AND channelId = :channelId
  AND seq < :seq
ORDER BY seq DESC, id DESC
LIMIT :limit;

selectFactsInScopeAfter:
SELECT * FROM messageEntity
WHERE environmentId = :environmentId
  AND serverId = :serverId
  AND principalId = :principalId
  AND consumerId = :consumerId
  AND scopeKind = :scopeKind
  AND channelId = :channelId
  AND seq > :seq
ORDER BY seq, id
LIMIT :limit;

-- Schema v10: where a fact id is stored in a partition (an anchored open reads around it).
selectFactLocationById:
SELECT scopeKind, channelId, seq FROM messageEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND id = ?;

-- Schema v10 per-scope retention: the scope's facts that retention may delete (pinned thread roots
-- excluded), oldest first.
countUnpinnedFactsInScope:
SELECT COUNT(*) FROM messageEntity AS fact
WHERE fact.environmentId = ?
  AND fact.serverId = ?
  AND fact.principalId = ?
  AND fact.consumerId = ?
  AND fact.scopeKind = ?
  AND fact.channelId = ?
  AND NOT EXISTS (
    SELECT 1
    FROM syncCursorEntity AS reply
    WHERE reply.environmentId = fact.environmentId
      AND reply.serverId = fact.serverId
      AND reply.principalId = fact.principalId
      AND reply.consumerId = fact.consumerId
      AND reply.scopeKind = 'thread'
      AND reply.parentScopeKind = fact.scopeKind
      AND reply.parentScopeId = fact.channelId
      AND reply.rootMessageId = fact.id
  );

selectUnpinnedFactSeqsInScope:
SELECT fact.id, fact.seq FROM messageEntity AS fact
WHERE fact.environmentId = ?
  AND fact.serverId = ?
  AND fact.principalId = ?
  AND fact.consumerId = ?
  AND fact.scopeKind = ?
  AND fact.channelId = ?
  AND NOT EXISTS (
    SELECT 1
    FROM syncCursorEntity AS reply
    WHERE reply.environmentId = fact.environmentId
      AND reply.serverId = fact.serverId
      AND reply.principalId = fact.principalId
      AND reply.consumerId = fact.consumerId
      AND reply.scopeKind = 'thread'
      AND reply.parentScopeKind = fact.scopeKind
      AND reply.parentScopeId = fact.channelId
      AND reply.rootMessageId = fact.id
  )
ORDER BY fact.seq, fact.id;

selectSegmentsForScope:
SELECT * FROM messageSegmentEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?
ORDER BY lowSeq;

upsertSegment:
INSERT OR REPLACE INTO messageSegmentEntity(
  environmentId,
  serverId,
  principalId,
  consumerId,
  scopeKind,
  scopeId,
  lowSeq,
  highSeq,
  reachesOldest,
  headAtVerify,
  verifiedAtMs,
  source
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSegment:
DELETE FROM messageSegmentEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?
  AND lowSeq = ?;

clearSegmentsForScope:
DELETE FROM messageSegmentEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?;

clearSegmentsForPartition:
DELETE FROM messageSegmentEntity
WHERE environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?;

purgeSegmentsForConsumer:
DELETE FROM messageSegmentEntity
WHERE consumerId = ?;

-- Count matching rows for the fail-stop guard: after insert-or-ignore + scoped update, the store asserts
-- exactly this row exists in THIS full scope. 0 = a cross-scope same-id collision (contract violation).
countCanonicalFactInScope:
SELECT COUNT(*) FROM messageEntity
WHERE id = ?
  AND environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?;

selectMessageViewerOverlay:
SELECT *
FROM messageViewerOverlayEntity
WHERE serverId = ?
  AND environmentId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND overlayKind = ?;

insertMessageViewerOverlay:
INSERT INTO messageViewerOverlayEntity(
  environmentId,
  serverId,
  principalId,
  consumerId,
  scopeKind,
  scopeId,
  subjectKind,
  subjectId,
  overlayKind,
  overlayVersion,
  completeness,
  payloadJson
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMessageViewerOverlayAtVersion:
UPDATE messageViewerOverlayEntity
SET overlayVersion = ?, completeness = ?, payloadJson = ?
WHERE serverId = ?
  AND environmentId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?
  AND subjectKind = ?
  AND subjectId = ?
  AND overlayKind = ?
  AND overlayVersion = ?;

deleteMessageViewerOverlaysForScope:
DELETE FROM messageViewerOverlayEntity
WHERE serverId = ?
  AND environmentId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND scopeId = ?;

-- Clear a scope's canonical server facts (snapshot rebaseline). No exclusions: savedMessageEntity was
-- removed (zero live consumers), so there is no cross-domain CASCADE to work around, and pending never
-- enters (seq NOT NULL). The full durable partition + scope identity is required.
clearCanonicalFactsForScope:
DELETE FROM messageEntity
WHERE serverId = ?
  AND environmentId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?;

-- Snapshot rebaseline keeps exact roots that are still referenced by retained typed reply cursors.
clearUnpinnedCanonicalFactsForScope:
DELETE FROM messageEntity
WHERE serverId = ?
  AND environmentId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?
  AND NOT EXISTS (
    SELECT 1
    FROM syncCursorEntity AS reply
    WHERE reply.environmentId = messageEntity.environmentId
      AND reply.serverId = messageEntity.serverId
      AND reply.principalId = messageEntity.principalId
      AND reply.consumerId = messageEntity.consumerId
      AND reply.scopeKind = 'thread'
      AND reply.parentScopeKind = messageEntity.scopeKind
      AND reply.parentScopeId = messageEntity.channelId
      AND reply.rootMessageId = messageEntity.id
  );

-- Retention prune: delete one canonical fact by id within its full scope.
deleteCanonicalFactInScope:
DELETE FROM messageEntity
WHERE id = ?
  AND environmentId = ?
  AND serverId = ?
  AND principalId = ?
  AND consumerId = ?
  AND scopeKind = ?
  AND channelId = ?;

selectTaskReference:
SELECT *
FROM taskSummaryEntity
WHERE serverId = ?
  AND id = ?;

upsertTaskReference:
INSERT OR REPLACE INTO taskSummaryEntity(
  id,
  serverId,
  messageId,
  parentMessageId,
  channelId,
  title,
  status,
  taskNumber,
  isThreadTask,
  assigneeId,
  assigneeDisplayName,
  assigneeHandle,

  channelName,
  updatedAtLabel,
  capabilities,
  lastSyncedAtMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTaskReferencesForMessage:
SELECT *
FROM taskSummaryEntity
WHERE serverId = ?
  AND (id = ? OR messageId = ? OR parentMessageId = ?)
ORDER BY COALESCE(taskNumber, 9223372036854775807), id;

selectTaskReferencesForChannel:
SELECT *
FROM taskSummaryEntity
WHERE serverId = ?
  AND channelId = ?
ORDER BY COALESCE(taskNumber, 9223372036854775807), id;

selectAllTaskReferences:
SELECT *
FROM taskSummaryEntity
WHERE serverId = ?
ORDER BY COALESCE(updatedAtLabel, '') DESC,
         COALESCE(taskNumber, 9223372036854775807),
         id;

selectTaskContext:
SELECT *
FROM taskSummaryEntity
WHERE serverId = ?
  AND (
    id = ?
    OR messageId = ?
    OR parentMessageId = ?
    OR taskNumber = ?
  )
LIMIT 1;

deleteTaskReference:
DELETE FROM taskSummaryEntity
WHERE serverId = ?
  AND id = ?;

upsertMemberSnapshot:
INSERT OR REPLACE INTO memberProfileEntity(

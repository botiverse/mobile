<?xml version="1.0" encoding="utf-8"?>
<!-- The in-chat video player. A TextureView surface draws in the view hierarchy, so the video moves
     with the message list while it scrolls; the default SurfaceView is a separate window layer that
     trails the list by a frame or more (artin, 10-31). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />

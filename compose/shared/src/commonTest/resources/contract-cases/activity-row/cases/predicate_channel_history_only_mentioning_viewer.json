{
  "formatVersion": 1,
  "id": "predicate_channel_history_only_mentioning_viewer",
  "rule": "predicate",
  "title": "On a channel row, a history-only notice that mentions the viewer lights the @ and moves the row",
  "why": "A history-only notice's subject gets it as a personal mention: the @ lights without counting, and the row moves with people_activity_rows_v0 on or off (a personal mention is activity for them, #proj-raft-ui:#321).",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/web/src/store/inboxInPlaceUnread.ts (liveActivityUnread, liveUnreadFields)",
      "packages/web/src/store/inboxRowPosition.ts (rowPositionVerdict, with inbox_row_position_v1 on)",
      "packages/shared/src/activityUnreadPredicate.ts (peopleRowMessageMoves fullRule: activityLiveUnread rules.peopleActivityRows)"
    ],
    "server": [
      "packages/server/src/services/inboxUnreadEligibility.ts (isMessageUnreadEligibleForReceiver, messageCountsAsUnreadActivitySql)",
      "packages/server/src/services/inboxUnreadEligibility.ts (peopleRowMovingMessageSql, chatRowPeopleMovingMessageSql with fullRule)"
    ]
  },
  "given": {
    "viewer": {
      "type": "user",
      "id": "viewer-1"
    },
    "scope": {
      "rowKind": "channel"
    },
    "message": {
      "senderType": "system",
      "senderId": "system",
      "messageType": "system",
      "causalActorType": "user",
      "causalActorId": "user-2",
      "systemSubtype": "channel.human_membership",
      "countsUnread": false,
      "mentions": [
        {
          "type": "user",
          "id": "viewer-1"
        }
      ]
    }
  },
  "steps": [],
  "expect": {
    "verdict": {
      "counts": false,
      "mention": true,
      "moves": true
    }
  }
}

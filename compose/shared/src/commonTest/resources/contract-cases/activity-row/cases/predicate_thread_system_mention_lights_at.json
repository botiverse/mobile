{
  "formatVersion": 1,
  "id": "predicate_thread_system_mention_lights_at",
  "rule": "predicate",
  "title": "On a thread row, a system message the viewer caused that mentions them lights the @ without counting",
  "why": "The mention arm is separate from the unread count.",
  "status": "agreed",
  "sources": {
    "web": [
      "packages/web/src/store/inboxInPlaceUnread.ts (liveActivityUnread, liveUnreadFields)"

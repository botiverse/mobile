source 'https://cdn.cocoapods.org/'

target 'iosApp' do
  use_frameworks!
  platform :ios, '15.0'

  pod 'shared', :path => '../shared'

  pod 'Hands', :git => 'https://github.com/oranix-io/hands.git', :tag => 'ios-v0.2.2'
  pod 'SDWebImage'
  # task #436: SVG decoding for the durable avatar store (RaftIosAvatarCacheProvider
  # decodes committed avatar bytes through SDWebImage; UIImage has no native SVG
  # support). SDWebImage's official SVG coder (native CoreSVG, iOS 13+) is
  # registered at startup (see iOSApp.swift). Pages draw images with the Kotlin
  # Raft Coil loader (coil-svg for SVG).
  pod 'SDWebImageSVGCoder'
  pod 'Socket.IO-Client-Swift', '~> 16.1'
  pod 'MMKV', '~> 2.4.0'

  # Hosted tests resolve production symbols through TEST_HOST. Inherit the
  # same pod search paths for compile-time signatures, but do not link the
  # static Shared framework a second time into the test bundle: that creates
  # duplicate Kotlin runtime/classes and can crash before XCTest starts.
  target 'iosAppTests' do
    inherit! :search_paths
  end

  # App strings, bundled files and fonts are Compose Multiplatform resources. `shared` is a
  # static framework and compose.ios.resources.sync=false, so this phase copies them into the
  # .app (see :ui-cmp:syncComposeResourcesForXcodeApp).
  script_phase :name => 'Copy Compose resources to app',
    :execution_position => :after_compile,
    :shell_path => '/bin/sh',
    :script => <<-CMD
set -e
# The Gradle project root is compose/ (gradlew + settings.gradle.kts live there),
# one level up from this target's $SRCROOT (compose/iosApp).
GRADLE_ROOT="$SRCROOT/.."
# :ui-cmp:syncComposeResourcesForXcodeApp copies the Compose Multiplatform resources
# (Raft fonts, the app strings and bundled files of :shared) to <App>.app/compose-resources,
# where the CMP runtime reads them; compose.ios.resources.sync=false keeps the CMP plugin
# from doing it.
"$GRADLE_ROOT/gradlew" -p "$GRADLE_ROOT" :ui-cmp:syncComposeResourcesForXcodeApp \\
  -Praft.cmp.resources.dir="$BUILT_PRODUCTS_DIR/$CONTENTS_FOLDER_PATH/compose-resources"
CMD
end

post_install do |installer|
  # The release archive lane signs the app target manually via xcodebuild
  # build settings. Those settings are global, so without this guard CocoaPods
  # framework targets also receive the app provisioning profile and fail with
  # "does not support provisioning profiles". Pods are embedded/signed by the
  # app copy-frameworks phase; their own build targets should not sign.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      # Xcode 27 only builds for iOS 15.0+, and some pods still declare 9.0-14.x.
      # The app's own floor is 15.0 (platform above), so lift lower pod targets to it.
      target_version = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if target_version.nil? || Gem::Version.new(target_version) < Gem::Version.new('15.0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end

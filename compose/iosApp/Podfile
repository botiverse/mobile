source 'https://cdn.cocoapods.org/'

kuikly_release = '2.28.0-raft.15'
kuikly_binary_version = "#{kuikly_release}-2.1.21"
kuikly_coordinate = "com.tencent.kuikly-open:core-render-ios:#{kuikly_binary_version}"
kuikly_podspec = "../build/kuikly/core-render-ios-#{kuikly_binary_version}.podspec.json"
kuikly_podspec_output = File.expand_path(kuikly_podspec, __dir__)
kuikly_fetcher = File.expand_path('../../scripts/ci/fetch_kuikly_release_artifact.py', __dir__)
unless system(
  'python3', kuikly_fetcher,
  '--release', kuikly_release,
  '--coordinate', kuikly_coordinate,
  '--kind', 'podspec-json',
  '--output', kuikly_podspec_output
)
  abort "Kuikly release is incomplete or its iOS podspec failed byte verification"
end

target 'iosApp' do
  use_frameworks!
  platform :ios, '15.0'

  pod 'OpenKuiklyIOSRender', :podspec => kuikly_podspec
  pod 'shared', :path => '../shared'

  pod 'Hands', :git => 'https://github.com/oranix-io/hands.git', :tag => 'ios-v0.2.1'
  pod 'SDWebImage'
  # task #436: SVG decoding for iOS. Kuikly loads images via UIImage (no native
  # SVG support), so provider icons shipped as SVG rendered blank. SDWebImage's
  # official SVG coder (native CoreSVG, iOS 13+) decodes SVG through the image
  # pipeline once registered at startup (see iOSApp.swift).
  pod 'SDWebImageSVGCoder'
  pod 'Socket.IO-Client-Swift', '~> 16.1'
  pod 'MMKV', '~> 2.4.0'

  # Hosted tests resolve production symbols through TEST_HOST. Inherit the
  # same pod search paths for compile-time signatures, but do not link the
  # static Shared framework a second time into the test bundle: that creates
  # duplicate Kotlin runtime/classes and can crash before XCTest starts.
  target 'iosAppTests' do
    inherit! :search_paths
  end

  # task #423: the moko/TMM kmmresource plugin packs the `MR` resource bundle
  # (strings + the reaction sprite atlas) into the shared klib/framework. Because
  # `shared` is a *static* framework, that `.bundle` is not auto-copied into the
  # .app, so the plugin's `copyFrameworkResourcesToApp` task copies it out of the
  # built framework (resource-core >= 0.1.0-raft.2 lands the bundle at the
  # framework root and reads the Xcode destination from these gradle -P props).
  # Without this build phase, any `MR.*` access throws
  # FileFailedToInitializeException on iOS.
  script_phase :name => 'Copy kmmresource MR bundle to app',
    :execution_position => :after_compile,
    :shell_path => '/bin/sh',
    :script => <<-CMD
set -e
# The Gradle project root is compose/ (gradlew + settings.gradle.kts live there),
# one level up from this target's $SRCROOT (compose/iosApp).
GRADLE_ROOT="$SRCROOT/.."
"$GRADLE_ROOT/gradlew" -p "$GRADLE_ROOT" :shared:copyFrameworkResourcesToApp \\
  -Ptmm.resources.BUILT_PRODUCTS_DIR="$BUILT_PRODUCTS_DIR" \\
  -Ptmm.resources.CONTENTS_FOLDER_PATH="$CONTENTS_FOLDER_PATH" \\
  -Ptmm.resources.CONFIGURATION="$CONFIGURATION" \\
  -Ptmm.resources.PLATFORM_NAME="$PLATFORM_NAME" \\
  -Ptmm.resources.ARCHS="$ARCHS"

# The kmmresource generator packs MR strings but NOT MR/assets into the bundle.
# The runtime reads assets via the moko convention: relativePath with '/'
# flattened to '+' and no 'assets/' prefix (see slock_mrBundleURLForRelativePath,
# #409). Inject every MR/assets file flattened to the bundle root, e.g.
#   assets/reactions/reaction_atlas_v1.png -> MR.bundle/reactions+reaction_atlas_v1.png
MR_ASSETS_SRC="$GRADLE_ROOT/shared/src/commonMain/resources/MR/assets"
MR_BUNDLE_DST="$BUILT_PRODUCTS_DIR/$CONTENTS_FOLDER_PATH/build.raft.app.resources.MR.bundle"
if [ -d "$MR_ASSETS_SRC" ] && [ -d "$MR_BUNDLE_DST" ]; then
  # Land under Contents/Resources/ to exactly match the verified-working Debug
  # simulator bundle shape (KMP task #22 evidence: assets live at
  # MR.bundle/Contents/Resources/<flattened>); the moko handler checks there
  # first. Create the dir if the Release bundle didn't have it.
  MR_DEST="$MR_BUNDLE_DST/Contents/Resources"
  mkdir -p "$MR_DEST"
  find "$MR_ASSETS_SRC" -type f | while IFS= read -r f; do
    rel=${f#"$MR_ASSETS_SRC/"}
    flat=$(printf '%s' "$rel" | tr '/' '+')
    cp -f "$f" "$MR_DEST/$flat"
    echo "MR asset injected: Contents/Resources/$flat"
  done
else
  echo "warning: MR assets src or bundle dst missing (src=$MR_ASSETS_SRC dst=$MR_BUNDLE_DST)" >&2
fi
CMD
end

post_install do |installer|
  # The release archive lane signs the app target manually via xcodebuild
  # build settings. Those settings are global, so without this guard CocoaPods
  # framework targets also receive the app provisioning profile and fail with
  # "does not support provisioning profiles". Pods are embedded/signed by the
  # app copy-frameworks phase; their own build targets should not sign.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
    end
  end
end

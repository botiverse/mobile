DROP INDEX IF EXISTS local_conversation_channel_id;
DROP INDEX IF EXISTS local_conversation_thread_id;
DROP INDEX IF EXISTS local_conversation_stream_channel_id;
DROP INDEX IF EXISTS local_conversation_server_kind;
DROP INDEX IF EXISTS local_message_thread_seq;
DROP INDEX IF EXISTS local_message_thread_id_id;
DROP INDEX IF EXISTS local_message_channel_seq;
DROP INDEX IF EXISTS local_message_server_channel_seq;
DROP INDEX IF EXISTS local_message_thread_channel_id;
DROP INDEX IF EXISTS local_message_parent_message_id;
DROP INDEX IF EXISTS local_attachment_message_id;
DROP INDEX IF EXISTS local_task_reference_message_id;
DROP INDEX IF EXISTS local_task_reference_parent_message_id;
DROP INDEX IF EXISTS local_task_reference_task_number;
DROP INDEX IF EXISTS local_task_reference_server_id;

DROP TABLE IF EXISTS local_message_thread;
DROP TABLE IF EXISTS local_attachment;
DROP TABLE IF EXISTS local_message;
DROP TABLE IF EXISTS local_task_reference;
DROP TABLE IF EXISTS local_member_snapshot;
DROP TABLE IF EXISTS local_sync_cursor;
DROP TABLE IF EXISTS local_outbox_message;
DROP TABLE IF EXISTS local_conversation;

CREATE TABLE local_conversation (
  server_id TEXT NOT NULL DEFAULT '',
  channel_id TEXT NOT NULL,
  thread_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  name TEXT NOT NULL,
  subtitle TEXT,
  parent_channel_id TEXT,
  parent_message_id TEXT,
  avatar_url TEXT,
  unread_count INTEGER NOT NULL DEFAULT 0,
  mention_count INTEGER NOT NULL DEFAULT 0,
  last_message_id TEXT,
  first_unread_message_id TEXT,
  last_message_preview TEXT,
  last_message_sender_name TEXT,
  presence TEXT,
  agent_status TEXT,
  presence_member_id TEXT,
  has_draft INTEGER NOT NULL DEFAULT 0,
  joined INTEGER NOT NULL DEFAULT 1,
  archived INTEGER NOT NULL DEFAULT 0,
  member_count INTEGER,
  capabilities INTEGER NOT NULL DEFAULT 15,
  updated_at_label TEXT,
  last_synced_at_ms INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (server_id, channel_id, thread_id)
);

CREATE INDEX local_conversation_channel_id ON local_conversation(server_id, channel_id);
CREATE INDEX local_conversation_thread_id ON local_conversation(server_id, thread_id);
CREATE INDEX local_conversation_server_kind ON local_conversation(server_id, kind);

CREATE TABLE local_message (
  id TEXT NOT NULL PRIMARY KEY,
  server_id TEXT NOT NULL DEFAULT '',
  thread_id TEXT NOT NULL,
  channel_id TEXT NOT NULL,
  seq INTEGER,
  author_id TEXT NOT NULL,
  author_display_name TEXT NOT NULL,
  author_handle TEXT NOT NULL,
  author_kind TEXT NOT NULL,
  author_description TEXT,
  timestamp_label TEXT NOT NULL,
  body TEXT NOT NULL,
  message_type TEXT NOT NULL,
  system_event_type TEXT,
  metadata_json TEXT NOT NULL DEFAULT '{}',
  delivery_state TEXT NOT NULL,
  reply_count INTEGER NOT NULL DEFAULT 0,
  parent_message_id TEXT,
  updated_at_label TEXT,
  last_synced_at_ms INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX local_message_thread_seq ON local_message(thread_id, seq);
CREATE INDEX local_message_thread_id_id ON local_message(thread_id, id);
CREATE INDEX local_message_channel_seq ON local_message(channel_id, seq);
CREATE INDEX local_message_server_channel_seq ON local_message(server_id, channel_id, seq);
CREATE INDEX local_message_parent_message_id ON local_message(parent_message_id);

CREATE TABLE local_message_thread (
  server_id TEXT NOT NULL DEFAULT '',
  parent_message_id TEXT NOT NULL REFERENCES local_message(id) ON DELETE CASCADE,
  thread_channel_id TEXT NOT NULL,
  reply_count INTEGER NOT NULL DEFAULT 0,
  updated_at_label TEXT,
  last_synced_at_ms INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (server_id, parent_message_id)
);

CREATE INDEX local_message_thread_channel_id ON local_message_thread(server_id, thread_channel_id);

CREATE TABLE local_attachment (
  id TEXT NOT NULL PRIMARY KEY,
  message_id TEXT NOT NULL REFERENCES local_message(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  mime_type TEXT NOT NULL,
  size_label TEXT NOT NULL,
  thumbnail_url TEXT,
  sort_order INTEGER NOT NULL
);

CREATE INDEX local_attachment_message_id ON local_attachment(message_id);

CREATE TABLE local_task_reference (
  id TEXT NOT NULL PRIMARY KEY,
  server_id TEXT NOT NULL DEFAULT '',
  message_id TEXT,
  parent_message_id TEXT,
  channel_id TEXT,
  thread_id TEXT,
  title TEXT NOT NULL,
  status TEXT NOT NULL,
  task_number INTEGER,
  is_thread_task INTEGER NOT NULL DEFAULT 0,
  assignee_id TEXT,
  assignee_display_name TEXT,
  assignee_handle TEXT,
  assignee_kind TEXT,
  channel_name TEXT,
  updated_at_label TEXT NOT NULL,
  can_claim INTEGER NOT NULL DEFAULT 1,
  last_synced_at_ms INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX local_task_reference_message_id ON local_task_reference(message_id);
CREATE INDEX local_task_reference_parent_message_id ON local_task_reference(parent_message_id);
CREATE INDEX local_task_reference_task_number ON local_task_reference(task_number);
CREATE INDEX local_task_reference_server_id ON local_task_reference(server_id);

CREATE TABLE local_member_snapshot (
  id TEXT NOT NULL,
  server_id TEXT NOT NULL DEFAULT '',
  display_name TEXT NOT NULL,
  handle TEXT NOT NULL,
  kind TEXT NOT NULL,
  avatar_url TEXT,
  gravatar_hash TEXT,
  avatar_label TEXT,
  presence TEXT,
  description TEXT,
  role_description TEXT,
  last_synced_at_ms INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (server_id, id)
);

CREATE TABLE local_sync_cursor (
  scope_id TEXT NOT NULL,
  server_id TEXT NOT NULL DEFAULT '',
  scope_kind TEXT NOT NULL,
  latest_seq INTEGER,
  oldest_loaded_seq INTEGER,
  newest_loaded_seq INTEGER,
  has_loaded_oldest INTEGER NOT NULL DEFAULT 0,
  has_loaded_newest INTEGER NOT NULL DEFAULT 1,
  updated_at_ms INTEGER NOT NULL,
  PRIMARY KEY (server_id, scope_id)
);

CREATE TABLE local_outbox_message (
  local_id TEXT NOT NULL PRIMARY KEY,
  server_id TEXT NOT NULL DEFAULT '',
  channel_id TEXT NOT NULL,
  thread_id TEXT NOT NULL,
  body TEXT NOT NULL,
  attachment_ids_json TEXT NOT NULL DEFAULT '[]',
  as_task INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL,
  created_at_ms INTEGER NOT NULL,
  last_error_code TEXT
);

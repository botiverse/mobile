diff --git a/latex-renderer/src/jvmTest/kotlin/com/hrm/latex/renderer/utils/GlyphBoundsWidthJvmTest.kt b/latex-renderer/src/jvmTest/kotlin/com/hrm/latex/renderer/utils/GlyphBoundsWidthJvmTest.kt
